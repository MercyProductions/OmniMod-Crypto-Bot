# Separate optional research processes. Copy values into your own local .env.
# Live trading and new-model production approval do not exist in this service.
CRYPTO_FORECAST_ENABLED=false
CRYPTO_FORECAST_URL=http://127.0.0.1:8765
CRYPTO_FORECAST_TOKEN=
CRYPTO_FORECAST_SOURCES=binance,coinbase
CRYPTO_FORECAST_MAX_CANDIDATES=6
CRYPTO_FORECAST_INTERVAL_SECONDS=60
CRYPTO_FORECAST_DEX_ENABLED=false
CRYPTO_FORECAST_DISCORD_ENABLED=false
CRYPTO_FORECAST_RESEARCH_CHANNEL_ID=
CRYPTO_FORECAST_DISCOVERY_BRIDGE_ENABLED=false
# Use a separate OMNIMOD_CRYPTO_DATA_DIR for isolated development/research.
